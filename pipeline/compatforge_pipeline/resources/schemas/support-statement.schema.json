{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/support-statement.schema.json",
  "title": "CompatForge Compatibility Support Statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "statement_id",
    "device_id",
    "scope",
    "support_status",
    "evidence",
    "reviewed_at",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "compatibility_support_statement"},
    "statement_id": {"type": "string", "pattern": "^sup_[a-z0-9][a-z0-9_-]{5,95}$"},
    "device_id": {"type": "string", "pattern": "^usb:[0-9A-F]{4}:[0-9A-F]{4}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "operating_system", "connection"],
      "properties": {
        "architecture": {"enum": ["x86_64", "arm64", "any"]},
        "operating_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "version_mode"],
          "properties": {
            "family": {"enum": ["windows", "macos", "ubuntu"]},
            "version_mode": {"enum": ["exact", "one_of", "minimum", "any"]},
            "versions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 40}
            },
            "minimum_version": {"type": "string", "minLength": 1, "maxLength": 40}
          },
          "allOf": [
            {
              "if": {"properties": {"version_mode": {"enum": ["exact", "one_of"]}}},
              "then": {"required": ["versions"]}
            },
            {
              "if": {"properties": {"version_mode": {"const": "minimum"}}},
              "then": {"required": ["minimum_version"]}
            }
          ]
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["any_usb", "direct_port", "usb_hub", "adapter", "dock"]},
            "minimum_usb_generation": {"enum": ["1.1", "2.0", "3.0", "3.1", "3.2", "4"]}
          }
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "support_status": {"enum": ["supported", "supported_with_conditions", "unsupported"]},
    "conditions": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "sources", "source_note"],
      "properties": {
        "source_type": {"enum": ["vendor_documentation", "issue_report"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_url", "source_title"],
            "properties": {
              "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "source_title": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        },
        "source_note": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"support_status": {"const": "supported_with_conditions"}}},
      "then": {"required": ["conditions"], "properties": {"conditions": {"minItems": 1}}}
    }
  ]
}
