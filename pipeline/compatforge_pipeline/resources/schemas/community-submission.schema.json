{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/community-submission.schema.json",
  "title": "CompatForge community evidence submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "client_submission_id",
    "prepared_at",
    "evidence_ready",
    "target_device_id",
    "handoff",
    "configuration",
    "reproduction",
    "publication",
    "privacy",
    "references"
  ],
  "properties": {
    "record_type": {"const": "community_evidence_submission"},
    "schema_version": {"const": "1.0.0"},
    "client_submission_id": {"type": "string", "format": "uuid"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "evidence_ready": {"const": false},
    "target_device_id": {
      "type": "string",
      "pattern": "^usb:[0-9A-F]{4}:[0-9A-F]{4}$"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sha256", "user_approved_export"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "user_approved_export": {"const": true}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "operating_system", "architecture", "connection_path", "drivers"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manufacturer": {"type": "string", "minLength": 1, "maxLength": 200},
            "model": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        },
        "operating_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "version"],
          "properties": {
            "family": {"enum": ["windows", "macos", "ubuntu", "linux", "unknown"]},
            "version": {"type": "string", "minLength": 1, "maxLength": 100},
            "build": {"type": "string", "minLength": 1, "maxLength": 100}
          }
        },
        "architecture": {"enum": ["x86_64", "arm64", "unknown"]},
        "connection_path": {"enum": ["direct_port", "usb_hub", "unspecified"]},
        "drivers": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 200},
              "provider": {"type": "string", "minLength": 1, "maxLength": 200},
              "version": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "observed_at", "steps_summary", "conditions", "limitations"],
      "properties": {
        "outcome": {"enum": ["works", "works_with_conditions", "fails"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "steps_summary": {"type": "string", "minLength": 20, "maxLength": 4000},
        "conditions": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "firmware_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "software_version": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anonymized_publication", "consent_version"],
      "properties": {
        "anonymized_publication": {"const": true},
        "consent_version": {"const": "1.0"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_raw_diagnostic",
        "contains_serial_numbers",
        "contains_network_identifiers",
        "contains_unrelated_usb_inventory",
        "automatic_publication"
      ],
      "properties": {
        "contains_raw_diagnostic": {"const": false},
        "contains_serial_numbers": {"const": false},
        "contains_network_identifiers": {"const": false},
        "contains_unrelated_usb_inventory": {"const": false},
        "automatic_publication": {"const": false}
      }
    },
    "references": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reproduction": {
            "properties": {"outcome": {"const": "works_with_conditions"}},
            "required": ["outcome"]
          }
        }
      },
      "then": {
        "properties": {
          "reproduction": {
            "properties": {"conditions": {"minItems": 1}}
          }
        }
      }
    }
  ]
}
