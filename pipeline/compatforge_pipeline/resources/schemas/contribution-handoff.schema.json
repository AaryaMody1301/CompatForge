{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/contribution-handoff.schema.json",
  "title": "CompatForge contribution handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "prepared_at",
    "user_approved_export",
    "evidence_ready",
    "source_diagnostic_generated_at",
    "target_device_id",
    "configuration",
    "local_context",
    "privacy",
    "limitations"
  ],
  "properties": {
    "record_type": {"const": "contribution_handoff"},
    "schema_version": {"const": "1.0.0"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "user_approved_export": {"const": true},
    "evidence_ready": {"const": false},
    "source_diagnostic_generated_at": {"type": "string", "format": "date-time"},
    "target_device_id": {
      "type": "string",
      "pattern": "^usb:[0-9A-F]{4}:[0-9A-F]{4}$"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "operating_system",
        "architecture",
        "target_present",
        "connection_paths",
        "drivers"
      ],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manufacturer": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1}
          }
        },
        "operating_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "version"],
          "properties": {
            "family": {
              "enum": ["windows", "macos", "ubuntu", "linux", "unknown"]
            },
            "version": {"type": "string", "minLength": 1},
            "build": {"type": "string", "minLength": 1}
          }
        },
        "architecture": {"enum": ["x86_64", "arm64", "unknown"]},
        "target_present": {"type": ["boolean", "null"]},
        "connection_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["direct_port", "usb_hub", "unspecified"]}
        },
        "drivers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "provider": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "local_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanation_status", "snapshot_sha256", "results"],
      "properties": {
        "explanation_status": {
          "enum": ["resolved", "target_absent", "target_collection_unavailable"]
        },
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connection_path",
              "claim_state",
              "specificity",
              "observation_ids",
              "support_state",
              "support_statement_ids"
            ],
            "properties": {
              "connection_path": {
                "enum": ["direct_port", "usb_hub", "unspecified"]
              },
              "claim_state": {
                "enum": ["works", "works_with_conditions", "fails", "conflicting", "unknown"]
              },
              "specificity": {
                "enum": ["exact", "host_relaxed", "os_version_relaxed", "none"]
              },
              "observation_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "support_state": {
                "enum": [
                  "supported",
                  "supported_with_conditions",
                  "unsupported",
                  "conflicting",
                  "unknown"
                ]
              },
              "support_statement_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_upload",
        "network_request_performed",
        "serial_numbers_in_handoff",
        "network_identifiers_in_handoff",
        "unrelated_usb_devices_in_handoff"
      ],
      "properties": {
        "automatic_upload": {"const": false},
        "network_request_performed": {"const": false},
        "serial_numbers_in_handoff": {"const": false},
        "network_identifiers_in_handoff": {"const": false},
        "unrelated_usb_devices_in_handoff": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
