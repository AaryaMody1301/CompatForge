{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/observation.schema.json",
  "title": "CompatForge Compatibility Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "observation_id", "device_id", "host", "connection_path", "outcome", "evidence", "observed_at", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "compatibility_observation"},
    "observation_id": {"type": "string", "pattern": "^obs_[a-z0-9][a-z0-9_-]{5,63}$"},
    "device_id": {"type": "string", "pattern": "^usb:[0-9A-F]{4}:[0-9A-F]{4}$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "architecture", "operating_system"],
      "properties": {
        "manufacturer": {"type": "string", "minLength": 1, "maxLength": 120},
        "model": {"type": "string", "minLength": 1, "maxLength": 160},
        "architecture": {"enum": ["x86_64", "arm64"]},
        "operating_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "version"],
          "properties": {
            "family": {"enum": ["windows", "macos", "ubuntu"]},
            "version": {"type": "string", "minLength": 1, "maxLength": 80},
            "build": {"type": "string", "maxLength": 80}
          }
        }
      }
    },
    "connection_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["direct_port", "usb_hub", "adapter", "dock", "cable"]},
          "manufacturer": {"type": "string", "maxLength": 120},
          "model": {"type": "string", "maxLength": 160},
          "notes": {"type": "string", "maxLength": 500}
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "firmware_version": {"type": "string", "maxLength": 80},
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "outcome": {"enum": ["works", "works_with_conditions", "fails"]},
    "conditions": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_url", "source_title"],
      "properties": {
        "source_type": {"enum": ["vendor_documentation", "independent_reproduction", "diagnostic_report", "issue_report", "community_report"]},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_title": {"type": "string", "minLength": 1, "maxLength": 300},
        "source_excerpt": {"type": "string", "maxLength": 1000}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "limitations": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "notes": {"type": "string", "maxLength": 2000}
  },
  "allOf": [{"if": {"properties": {"outcome": {"const": "works_with_conditions"}}}, "then": {"required": ["conditions"], "properties": {"conditions": {"minItems": 1}}}}]
}
